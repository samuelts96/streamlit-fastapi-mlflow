# Copy to .env and adjust per environment.

# Where the frontend finds the backend. In docker compose this is the service name.
# Once deployed (e.g. ECS), point it at the address the backend is reachable on
# (ALB DNS name, Cloud Map service-discovery name, or task IP).
BACKEND_URL=http://backend:8000
SERVICE_NAME=backend

# Host ports (defaults shown). Change one only if it's already taken on your machine.
# MLflow uses 5001 because macOS AirPlay Receiver listens on 5000.
MLFLOW_PORT=5001
API_PORT=8000
FRONTEND_PORT=8501

# Registered model the backend serves (it loads models:/<MODEL_NAME>@champion at startup).
MODEL_NAME=iris-classifier
